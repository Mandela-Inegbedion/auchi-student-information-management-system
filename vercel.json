{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix management_frontend",
  "buildCommand": "npm run build:vercel --prefix management_frontend",
  "outputDirectory": "management_frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://auchi-student-information-management.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
